# Copie para .env na raiz apenas para ativar a integração real.
# O CRM e a demonstração com banco local iniciam sem .env.
WHATSAPP_PROVIDER=zapi_omni
OMNI_API_BASE_URL=https://api.omni.z-api.io
OMNI_CHANNEL_ID=
OMNI_SECRET_KEY=
# Gerado pelo cadastro de webhook assinado. O comando de cadastro preenche estes campos.
OMNI_WEBHOOK_SECRET=
OMNI_WEBHOOK_ID=
# Opcional. Se vazio, o iniciador local utiliza a clínica fictícia da conta demo.
WHATSAPP_CLINIC_ID=
WHATSAPP_SCHEDULING_ENABLED=false
