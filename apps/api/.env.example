NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://127.0.0.1:4173
# Desenvolvimento local persistente, sem serviço externo:
DATABASE_URL=pglite://./.data/smilesync
# Produção: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
MIGRATE_ON_START=true
SESSION_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30
COOKIE_NAME=smilesync_session
# Ative somente em testes automatizados; nunca em homologação/produção.
EXPOSE_TEST_RESET_TOKENS=false
